const getActionDuration = (char: string): number => {
  if (char === 'ㄱ') return 2.05;
  if (char === 'ㅈ') return 3.8;
  if (char === 'ㅊ') return 2.4;
  if (char === 'ㅋ') return 2.35;
  if (char === 'ㅍ') return 2.6;
  if (char === 'ㅎ') return 3.25;
  if (char === 'ㅁ' || char === 'ㅇ') return 1.65;
  return 1.5;
};

