export const StickmanJaeumSim: React.FC<StickmanJaeumSimProps> = ({
  defaultAudioEnabled = true,
  lang = 'en',
  className = '',
}) => {
  const uid = useId();
  const [phase, setPhase] = useState<SimPhase>('walking');
  const [selectedConsonant, setSelectedConsonant] = useState<ConsonantItem>(KOREAN_CONSONANTS[0]);
  const [learnedChars, setLearnedChars] = useState<string[]>([]);
  const [isPaused, setIsPaused] = useState(false);
  const [audioEnabled, setAudioEnabled] = useState(defaultAudioEnabled);
  const [, setFrameTick] = useState(0);

  const animRef = useRef({
    walkX: 130,
    walkDir: 1 as 1 | -1,
    walkTime: 0,
    worldScrollX: 0,
    phaseElapsed: 0,
    approachStartX: 130,
    objectAppear: 0,
    actionT: 0,
    aftermathT: 0,
    step1Triggered: false,
    step2Triggered: false,
    lastTime: performance.now(),
  });

  const phaseRef = useRef<SimPhase>(phase);
  phaseRef.current = phase;
  const selectedRef = useRef<ConsonantItem>(selectedConsonant);
  selectedRef.current = selectedConsonant;
  const audioRef = useRef<boolean>(audioEnabled);
  audioRef.current = audioEnabled;
  const pausedRef = useRef<boolean>(isPaused);
  pausedRef.current = isPaused;

  const timersRef = useRef<number[]>([]);
  const audioCtxRef = useRef<AudioContext | null>(null);
  const activeOscRef = useRef<Set<OscillatorNode>>(new Set());

  const stopAllAudio = useCallback(() => {
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    activeOscRef.current.forEach((osc) => {
      try {
        osc.stop();
        osc.disconnect();
      } catch {
        // Ignore already stopped oscillators
      }
    });
    activeOscRef.current.clear();
  }, []);

  const clearAllTimers = useCallback(() => {
    timersRef.current.forEach((id) => window.clearTimeout(id));
    timersRef.current = [];
  }, []);

  // Cleanup everything cleanly when modal/component unmounts
  useEffect(() => {
    return () => {
      clearAllTimers();
      stopAllAudio();
      if (audioCtxRef.current && audioCtxRef.current.state !== 'closed') {
        audioCtxRef.current.close().catch(() => {});
        audioCtxRef.current = null;
      }
    };
  }, [clearAllTimers, stopAllAudio]);

  // Web Audio & Speech helpers (component-scoped so unmount cleans everything)
  const getAudioCtx = useCallback((): AudioContext | null => {
    if (typeof window === 'undefined') return null;
    if (!audioCtxRef.current || audioCtxRef.current.state === 'closed') {
      const Ctx =
        window.AudioContext ||
        (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (Ctx) {
        audioCtxRef.current = new Ctx();
      }
    }
    if (audioCtxRef.current && audioCtxRef.current.state === 'suspended') {
      audioCtxRef.current.resume().catch(() => {});
    }
    return audioCtxRef.current;
  }, []);

  const registerOsc = useCallback((osc: OscillatorNode) => {
    activeOscRef.current.add(osc);
    osc.onended = () => {
      activeOscRef.current.delete(osc);
    };
  }, []);

  const playCutePop = useCallback(() => {
    try {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(450, now);
      osc.frequency.exponentialRampToValueAtTime(880, now + 0.08);
      gain.gain.setValueAtTime(0.18, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      osc.connect(gain);
      gain.connect(ctx.destination);
      registerOsc(osc);
      osc.start(now);
      osc.stop(now + 0.1);
    } catch {
      // Silent fallback
    }
  }, [getAudioCtx, registerOsc]);

